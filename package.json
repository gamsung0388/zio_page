{
  "name": "zio-home",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "deploy": "node scripts/check-deploy.js && npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply zio-home-db --local",
    "db:migrate:remote": "node scripts/check-deploy.js && wrangler d1 migrations apply zio-home-db --remote",
    "admin:create": "node scripts/admin.js create",
    "admin:revoke": "node scripts/admin.js revoke",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "vue": "3.5.44",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.64.0",
    "@inquirer/password": "5.2.3",
    "@inquirer/testing": "3.3.14",
    "@playwright/test": "1.64.1",
    "@vitejs/plugin-vue": "6.0.10",
    "esbuild": "0.28.2",
    "jsonc-parser": "3.3.1",
    "miniflare": "4.20260730.0",
    "vite": "8.3.4",
    "wrangler": "4.151.0"
  }
}
